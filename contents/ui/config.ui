          <item row="3" column="0"><widget class="QLabel" name="label_leaveMargin"><property name="text"><string>Leave margin</string></property><property name="toolTip"><string>Extra tolerance before a revealed window hides again after the cursor leaves.</string></property></widget></item>
          <item row="3" column="1"><widget class="QSpinBox" name="kcfg_leaveMargin"><property name="suffix"><string> px</string></property><property name="minimum"><number>0</number></property><property name="maximum"><number>200</number></property></widget></item>
          <item row="4" column="0"><widget class="QLabel" name="label_moveTolerance"><property name="text"><string>Move-away tolerance</string></property><property name="toolTip"><string>How far a revealed window must move away from its docked edge before it undocks.</string></property></widget></item>
