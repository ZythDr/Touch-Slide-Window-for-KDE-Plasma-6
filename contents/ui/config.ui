       <item>
        <widget class="QGroupBox" name="groupAttention">
         <property name="title"><string>Notification / attention poke</string></property>
         <layout class="QFormLayout" name="formAttention">
<property name="formAlignment"><set>Qt::AlignHCenter|Qt::AlignTop</set></property>
<property name="labelAlignment"><set>Qt::AlignRight</set></property>
          <item row="0" column="0"><widget class="QLabel" name="label_attn_enabled"><property name="text"><string>Enable attention poke</string></property><property name="toolTip"><string>Animate a docked hidden window when it demands attention.</string></property></widget></item>
          <item row="0" column="1"><widget class="QCheckBox" name="kcfg_attentionPokeEnabled"><property name="toolTip"><string>Some apps may not set the window-attention flag; this depends on the app.</string></property></widget></item>
          <item row="1" column="0"><widget class="QLabel" name="label_attn_pixels"><property name="text"><string>Poke distance</string></property><property name="toolTip"><string>How far inward the window moves during each notification poke.</string></property></widget></item>
          <item row="1" column="1"><widget class="QSpinBox" name="kcfg_attentionPokePixels"><property name="toolTip"><string>Higher values make the notification movement more visible.</string></property><property name="suffix"><string> px</string></property><property name="minimum"><number>1</number></property><property name="maximum"><number>500</number></property></widget></item>
          <item row="2" column="0"><widget class="QLabel" name="label_attn_hold"><property name="text"><string>Hold time per repeat</string></property><property name="toolTip"><string>How long the window pauses at the inward position on each repeat. Low values act like a bounce.</string></property></widget></item>
          <item row="2" column="1"><widget class="QSpinBox" name="kcfg_attentionPokeHoldMs"><property name="toolTip"><string>Use around 50-150 ms for bounce-like movement, or higher values for a peek.</string></property><property name="suffix"><string> ms</string></property><property name="minimum"><number>0</number></property><property name="maximum"><number>30000</number></property></widget></item>
          <item row="3" column="0"><widget class="QLabel" name="label_repeat"><property name="text"><string>Repeat count</string></property><property name="toolTip"><string>How many times to move inward and back. 1=single peek, 2+=bounce/repeated peek.</string></property></widget></item>
          <item row="3" column="1"><widget class="QSpinBox" name="kcfg_attentionRepeatCount"><property name="toolTip"><string>Set to 2 or 3 with a low hold time for a bounce effect.</string></property><property name="minimum"><number>1</number></property><property name="maximum"><number>20</number></property></widget></item>
          <item row="4" column="0"><widget class="QLabel" name="label_cd"><property name="text"><string>Cooldown</string></property><property name="toolTip"><string>Minimum delay before the same window can poke again from app attention events.</string></property></widget></item>
          <item row="4" column="1"><widget class="QSpinBox" name="kcfg_attentionPokeCooldownMs"><property name="toolTip"><string>Manual preview ignores this cooldown.</string></property><property name="suffix"><string> ms</string></property><property name="minimum"><number>0</number></property><property name="maximum"><number>60000</number></property></widget></item>
          <item row="5" column="0"><widget class="QLabel" name="label_attentionSteps"><property name="text"><string>Attention animation steps</string></property><property name="toolTip"><string>Number of movement steps used only for notification poke animation.</string></property></widget></item>
          <item row="5" column="1"><widget class="QSpinBox" name="kcfg_attentionAnimationSteps"><property name="minimum"><number>1</number></property><property name="maximum"><number>80</number></property></widget></item>
          <item row="6" column="0"><widget class="QLabel" name="label_attentionInterval"><property name="text"><string>Attention animation interval</string></property><property name="toolTip"><string>Delay between notification animation steps.</string></property></widget></item>
          <item row="6" column="1"><widget class="QSpinBox" name="kcfg_attentionAnimationIntervalMs"><property name="toolTip"><string>Lower values move faster.</string></property><property name="suffix"><string> ms</string></property><property name="minimum"><number>1</number></property><property name="maximum"><number>100</number></property></widget></item>
         </layout>
        </widget>
       </item>
      </layout>
     </widget>

