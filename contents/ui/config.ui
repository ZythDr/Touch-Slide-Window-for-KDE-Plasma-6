<property name="formAlignment"><set>Qt::AlignHCenter|Qt::AlignTop</set></property>
<property name="labelAlignment"><set>Qt::AlignRight</set></property>
          <item row="0" column="0"><widget class="QLabel" name="label_animate"><property name="text"><string>Animate slide in/out</string></property><property name="toolTip"><string>Enable smooth movement. Disable for instant show/hide.</string></property></widget></item>
          <item row="0" column="1"><widget class="QCheckBox" name="kcfg_animate"><property name="toolTip"><string>Controls normal reveal/hide animation, not notification poke timing.</string></property></widget></item>
          <item row="1" column="0"><widget class="QLabel" name="label_steps"><property name="text"><string>Animation steps</string></property><property name="toolTip"><string>Number of movement steps for normal reveal/hide animation.</string></property></widget></item>
          <item row="1" column="1"><widget class="QSpinBox" name="kcfg_animationSteps"><property name="toolTip"><string>More steps is smoother but slower.</string></property><property name="minimum"><number>1</number></property><property name="maximum"><number>80</number></property></widget></item>
          <item row="2" column="0"><widget class="QLabel" name="label_interval"><property name="text"><string>Animation interval</string></property><property name="toolTip"><string>Delay between normal animation steps.</string></property></widget></item>
          
          <item row="3" column="0"><widget class="QLabel" name="label_dockHintMode"><property name="text"><string>Dock hint mode</string></property><property name="toolTip"><string>0=instant hidden, 1=animate to hidden, 2=show then stow, 3=attention poke after dock.</string></property></widget></item>
          <item row="3" column="1"><widget class="QSpinBox" name="kcfg_dockHintMode"><property name="toolTip"><string>0=instant hidden, 1=animate directly to stowed position, 2=show at edge then stow, 3=stow then attention poke.</string></property><property name="minimum"><number>0</number></property><property name="maximum"><number>3</number></property><property name="maximumSize"><size><width>80</width><height>16777215</height></size></property></widget></item>
          <item row="4" column="0"><widget class="QLabel" name="label_dockHintDelay"><property name="text"><string>Dock hint delay</string></property><property name="toolTip"><string>Delay before the stow/poke hint runs after docking.</string></property></widget></item>
          <item row="4" column="1"><widget class="QSpinBox" name="kcfg_dockHintDelayMs"><property name="suffix"><string> ms</string></property><property name="minimum"><number>0</number></property><property name="maximum"><number>5000</number></property><property name="singleStep"><number>100</number></property><property name="maximumSize"><size><width>120</width><height>16777215</height></size></property></widget></item>
          <item row="2" column="1"><widget class="QSpinBox" name="kcfg_animationIntervalMs"><property name="toolTip"><string>Lower values move faster.</string></property><property name="suffix"><string> ms</string></property><property name="minimum"><number>1</number></property><property name="maximum"><number>100</number></property></widget></item>
