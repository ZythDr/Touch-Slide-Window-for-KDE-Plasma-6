#!/usr/bin/env bash
set -euo pipefail

GROUP="Script-touch-slide-window"

default_for() {
  case "$1" in
    visibleStripPixels) echo 10 ;;
    revealGap) echo 8 ;;
    hoverMargin) echo 5 ;;
    leaveMargin) echo 8 ;;
    moveTolerance) echo 40 ;;
    animate) echo true ;;
    animationSteps) echo 12 ;;
    animationIntervalMs) echo 14 ;;
    dockToVirtualScreenEdges) echo true ;;
    suppressMinimizeFallback) echo true ;;
    allowMoveAlongDockEdge) echo true ;;
    hideOnDockEdgeHit) echo false ;;
    gestureDockEnabled) echo false ;;
    gestureDockMode) echo 0 ;;
    gestureDockThresholdPx) echo 20 ;;
    gestureDockTimeoutMs) echo 2500 ;;
    gestureDockConeDegrees) echo 35 ;;
    gestureIndicatorEnabled) echo true ;;
    gestureSelectorMode) echo 1 ;;
    gestureSelectorDistancePx) echo 78 ;;
    gestureSelectorTileSizePx) echo 54 ;;
    gestureSelectorMarginPx) echo 10 ;;
    dockHintMode) echo 2 ;;
    dockHintDelayMs) echo 500 ;;
    attentionPokeEnabled) echo true ;;
    attentionPokeMode) echo 0 ;;
    attentionPokePixels) echo 20 ;;
    attentionPokeHoldMs) echo 1200 ;;
    attentionRepeatCount) echo 2 ;;
    attentionPokeCooldownMs) echo 2000 ;;
    attentionAnimationSteps) echo 6 ;;
    attentionAnimationIntervalMs) echo 14 ;;
    resizeOnDockEnabled) echo false ;;
    centerOnDockEnabled) echo false ;;
    defaultResizeWidthValue) echo 0 ;;
    defaultResizeHeightValue) echo 90 ;;
    attentionPreviewCounter) echo 0 ;;
    restoreAllCounter) echo 0 ;;
    settingsCommand) echo "$HOME/.local/bin/touchslide-settings" ;;
    *)
      if [[ "$1" =~ ^override[0-9][0-9]Enabled$ ]]; then echo false
      elif [[ "$1" =~ ^override[0-9][0-9]Name$ ]]; then echo ""
      elif [[ "$1" =~ ^override[0-9][0-9]Match$ ]]; then echo ""
      elif [[ "$1" =~ ^override[0-9][0-9]Target$ ]]; then echo 0
      elif [[ "$1" =~ ^override[0-9][0-9]CenterEnabled$ ]]; then echo false
      elif [[ "$1" =~ ^override[0-9][0-9]ResizeEnabled$ ]]; then echo false
      elif [[ "$1" =~ ^override[0-9][0-9]WidthValue$ ]]; then echo 0
      elif [[ "$1" =~ ^override[0-9][0-9]HeightValue$ ]]; then echo 0
      else echo ""
      fi
      ;;
  esac
}

list_keys() {
  printf '%s\n' \
    visibleStripPixels \
    revealGap \
    hoverMargin \
    leaveMargin \
    moveTolerance \
    animate \
    animationSteps \
    animationIntervalMs \
    dockToVirtualScreenEdges \
    suppressMinimizeFallback \
    allowMoveAlongDockEdge \
    hideOnDockEdgeHit \
    gestureDockEnabled \
    gestureDockMode \
    gestureDockThresholdPx \
    gestureDockTimeoutMs \
    gestureDockConeDegrees \
    gestureIndicatorEnabled \
    gestureSelectorMode \
    gestureSelectorDistancePx \
    gestureSelectorTileSizePx \
    gestureSelectorMarginPx \
    dockHintMode \
    dockHintDelayMs \
    attentionPokeEnabled \
    attentionPokeMode \
    attentionPokePixels \
    attentionPokeHoldMs \
    attentionRepeatCount \
    attentionPokeCooldownMs \
    attentionAnimationSteps \
    attentionAnimationIntervalMs \
    resizeOnDockEnabled \
    centerOnDockEnabled \
    defaultResizeWidthValue \
    defaultResizeHeightValue \
    attentionPreviewCounter \
    restoreAllCounter \
    settingsCommand

  for i in $(seq -w 1 50); do
    printf '%s\n' \
      "override${i}Enabled" \
      "override${i}Name" \
      "override${i}Match" \
      "override${i}Target" \
      "override${i}CenterEnabled" \
      "override${i}ResizeEnabled" \
      "override${i}WidthValue" \
      "override${i}HeightValue"
  done
}

get_value() {
  local key="$1"
  local val
  val="$(kreadconfig6 --file kwinrc --group "$GROUP" --key "$key" 2>/dev/null || true)"
  if [ -z "$val" ]; then
    default_for "$key"
  else
    printf '%s\n' "$val"
  fi
}

usage() {
  cat <<'EOF'
touchslide-config - configure Touch Slide Window

Usage:
  touchslide-config list
  touchslide-config set KEY VALUE
  touchslide-config get KEY
  touchslide-config defaults
  touchslide-config preview
  touchslide-config restore-all
  touchslide-config reload
  touchslide-config safe-disable
  touchslide-config gui
EOF
}

reconfigure() {
  qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || true
}

write_default_if_missing() {
  local key="$1"
  local val
  val="$(kreadconfig6 --file kwinrc --group "$GROUP" --key "$key" 2>/dev/null || true)"
  if [ -z "$val" ]; then
    kwriteconfig6 --file kwinrc --group "$GROUP" --key "$key" "$(default_for "$key")"
  fi
}

bump_counter() {
  local key="$1"
  local old new
  old="$(get_value "$key")"
  case "$old" in ''|*[!0-9]*) old=0 ;; esac
  new=$((old + 1))
  kwriteconfig6 --file kwinrc --group "$GROUP" --key "$key" "$new"
  reconfigure
}


case "${1:-}" in
  list)
    for key in $(list_keys); do
      printf '%s=%s\n' "$key" "$(get_value "$key")"
    done
    ;;
  get)
    [ $# -eq 2 ] || { usage; exit 1; }
    get_value "$2"
    ;;
  set)
    [ $# -eq 3 ] || { usage; exit 1; }
    kwriteconfig6 --file kwinrc --group "$GROUP" --key "$2" "$3"
    reconfigure
    echo "Set $2=$3"
    ;;
  defaults)
    for key in $(list_keys); do
      write_default_if_missing "$key"
    done
    reconfigure
    echo "Wrote missing defaults to $GROUP."
    ;;
  preview)
    bump_counter attentionPreviewCounter
    echo "Triggered attention poke preview for docked windows."
    ;;
  restore-all)
    bump_counter restoreAllCounter
    echo "Requested restore of all docked windows."
    ;;
  reload)
    reconfigure
    echo "Requested KWin reconfigure. Press Meta+Ctrl+Alt+R if needed."
    ;;
  safe-disable)
    bump_counter restoreAllCounter
    sleep 1
    kwriteconfig6 --file kwinrc --group Plugins --key touch-slide-windowEnabled false
    qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || true
    echo "Requested restore-all, then disabled Touch Slide Window."
    ;;
  gui)
    kcmshell6 kcm_kwin4_genericscripted --args "touch-slide-window KWin/Script" --caption "Touch Slide Window Settings" \
      || systemsettings kcm_kwin_scripts \
      || exec "$(dirname "$0")/touchslide-settings"
    ;;
  *)
    usage
    exit 1
    ;;
esac
